  "typeDefs": {
    "lv": "{ l: string, v: number }",
    "ntd": "{ n: string, t: string, d: string }",
    "compareRow": "{ tag, tagSub?, left: {mark,main,sub?}, right: {mark,main,sub?} }",
    "sideCard": "{ side: 'left'|'right', mark, main, sub? }",
    "featureCard": "{ title, lines[], chip?, fn?: 'fn1'|'fn2' }",
    "leadText": "{ lead, text }",
    "titleText": "{ title, text }",
    "journeyBand": "{ text, role, from(노드 인덱스) }",
    "journeyNode": "{ age, ev, sub?, chip?, role, pos?(0..1) }",
    "optionRow": "{ name, cells: string[](criteria 수와 일치, ○/✕/△/텍스트), hi?: bool }",
    "kpiTile": "{ label, value, delta?, note?, tone?: 'ours'|'problem' }",
    "lane": "{ name, bars: [{from, to(col 인덱스), label?, role?}] }",
    "milestone": "{ col, label }",
    "lvObj": "{ l: string, v: number }",
    "lObj": "{ l: string }",
    "stackBar": "{ l, parts: [{name, v}] }"
  },
  "quantRule": "정량 판정은 메시지 문장 기준 — 수치·비교·추세가 문장에 명시돼야 차트형(bars/trend) 의무, 정량 함의만 있으면 도해 허용",
  "textAnswer": "글이 정답인 메시지 존재(정의·원칙·요청). 실패는 글이 아니라 문단으로 쓰는 것 — textgrid가 제3의 정당한 형태",
  "pickRule": "메시지에서 어느 단어가 싸움의 핵심인가"
}