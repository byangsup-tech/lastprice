{
  "schemaVersion": "deck-spec/1",
  "_notes": [
    "신규 템플릿 7종(간지 + 관계어 6종) 검증용 쇼케이스 — 내용은 전건 가정(예시).",
    "각 장이 서로 다른 템플릿(폼 변주 규정 준수)이며, validate 0에러 + 빌드 성공이 회귀 기준."
  ],
  "meta": {
    "title": "템플릿 쇼케이스",
    "deckLabel": "템플릿 쇼케이스",
    "author": "상품개발팀",
    "org": "default",
    "fileName": "template-showcase.pptx"
  },
  "slides": [
    {
      "id": "s0",
      "template": "section",
      "p": { "num": "A", "title": "신규 템플릿 쇼케이스", "sub": "관계어 6종 + 간지, 전 장 가정(예시) 데이터" }
    },
    {
      "id": "s1",
      "template": "kpi_tiles",
      "label": "파일럿 현황",
      "pill": "지표",
      "head": {
        "runs": [{ "t": "파일럿 핵심 지표가 목표 구간에 " }, { "t": "안착", "hl": true }, { "t": "함" }],
        "sub": "신계약·유지율·민원 세 지표 모두 목표 범위 내에서 진행됨"
      },
      "p": {
        "tiles": [
          { "label": "신계약", "value": "1,240건", "delta": "+18% (예시)", "tone": "ours", "note": "목표 1,100건" },
          { "label": "13회차 유지율", "value": "87%", "delta": "+3.2%p (예시)", "tone": "ours", "note": "기존 상품 대비" },
          { "label": "민원", "value": "2건", "delta": "전분기 동일 (예시)", "note": "전건 처리 완료" }
        ]
      },
      "assumed": true,
      "footnote": "* 수치는 전건 가정(예시), 파일럿 집계 확정 전"
    },
    {
      "id": "s2",
      "template": "option_table",
      "label": "확대 방식 대안",
      "pill": "대안 비교",
      "head": {
        "runs": [{ "t": "단계 확대안이 세 평가 기준을 모두 " }, { "t": "충족", "hl": true }, { "t": "함" }],
        "sub": "일괄 확대는 손해율 검증 전 리스크, 현행 유지는 시장 진입 시점을 놓치게 됨"
      },
      "p": {
        "criteria": ["손해율 검증", "시스템 부담", "채널 수용"],
        "options": [
          { "name": "일괄 확대", "cells": ["✕ 검증 전", "△ 동시 개발", "○ 높음"] },
          { "name": "단계 확대", "cells": ["○ 분기 검증", "○ 순차 개발", "○ 높음"], "hi": true },
          { "name": "현행 유지", "cells": ["○ 여유", "○ 없음", "✕ 이탈 위험"] }
        ],
        "note": "○ 충족 · △ 부분 충족 · ✕ 미충족"
      }
    },
    {
      "id": "s3",
      "template": "waterfall",
      "label": "손해율 변동 요인",
      "pill": "요인 분해",
      "head": {
        "runs": [{ "t": "손해율 개선분의 대부분이 " }, { "t": "무사고 전환", "hl": true }, { "t": "에서 발생함" }],
        "sub": "재산정 인수는 소폭 상승 요인이나 전환 효과가 상쇄함"
      },
      "band": "손해율 변동 요인 분해 (예시)",
      "p": {
        "unit": "손해율 지수 (기준 = 100)",
        "start": { "l": "기준", "v": 100 },
        "deltas": [
          { "l": "무사고 전환", "v": -4 },
          { "l": "재산정 인수", "v": 2 },
          { "l": "사업비", "v": -1 }
        ],
        "end": { "l": "파일럿" }
      },
      "assumed": true,
      "footnote": "* 요인 분해는 가정(예시), 계리 검증 전"
    },
    {
      "id": "s4",
      "template": "cycle",
      "label": "선순환 구조",
      "pill": "작동 메커니즘",
      "head": {
        "runs": [{ "t": "건강 개선과 보험료 인하가 서로를 " }, { "t": "강화", "hl": true }, { "t": "함" }],
        "sub": "재산정이 매 주기 작동해 개선 유인이 유지됨"
      },
      "p": {
        "steps": ["건강 개선", "등급 하향", "보험료 인하", "유지율 상승"],
        "center": "DP"
      }
    },
    {
      "id": "s5",
      "template": "stacked",
      "label": "채널 구성",
      "pill": "구성비",
      "head": {
        "runs": [{ "t": "판매 구성에서 GA " }, { "t": "비중이 확대", "hl": true }, { "t": "됨" }],
        "sub": "전속·TM 비중은 완만히 축소되는 구성임"
      },
      "band": "채널별 판매 구성비 (예시)",
      "p": {
        "pct": true,
        "bars": [
          { "l": "'25", "parts": [{ "name": "GA", "v": 52 }, { "name": "전속", "v": 30 }, { "name": "TM", "v": 18 }] },
          { "l": "'26", "parts": [{ "name": "GA", "v": 61 }, { "name": "전속", "v": 25 }, { "name": "TM", "v": 14 }] }
        ]
      },
      "assumed": true,
      "footnote": "* 구성비는 가정(예시), '26은 계획 수치"
    },
    {
      "id": "s6",
      "template": "roadmap",
      "label": "다음 단계",
      "pill": "일정",
      "head": {
        "runs": [{ "t": "3개 분기에 걸쳐 검증과 개발을 " }, { "t": "병행 진행", "hl": true }, { "t": "함" }],
        "sub": "확대 결정은 계리 검증 종료 시점에 수행함"
      },
      "p": {
        "cols": ["'26.3Q", "'26.4Q", "'27.1Q"],
        "lanes": [
          { "name": "계리", "bars": [{ "from": 0, "to": 1, "label": "무사고·사망률 상관 검증", "role": "fn1" }] },
          { "name": "규제", "bars": [{ "from": 0, "to": 0, "label": "중도부가 분류 협의", "role": "fn2" }] },
          { "name": "시스템", "bars": [{ "from": 1, "to": 2, "label": "재산정 모듈 개발", "role": "ours" }] }
        ],
        "milestones": [{ "col": 2, "label": "확대 결정" }]
      },
      "assumed": true,
      "footnote": "* 일정은 가정(예시), 확정 전"
    }
  ]
}
