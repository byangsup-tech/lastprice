# 어린이집정보공개포털(info.childcare.go.kr)에서 발급받은 인증키
# 신청: https://info.childcare.go.kr → 보육정보공개 API → OPEN API 신청
# 키가 없으면 앱은 강남/서초 일대 데모 데이터로 동작합니다.
CHILDCARE_API_KEY=

# (선택) API 엔드포인트 변경 시. 기본값:
# http://api.childcare.go.kr/mediate/rest/cpmsapi021/cpmsapi021/request
# CHILDCARE_API_ENDPOINT=

# ── 보험 상품개발 데스크 (/insurance) ──────────────────────────
# 네이버 뉴스 검색 API — https://developers.naver.com 앱 등록 후 발급 (무료 일 25,000회)
# 키가 없으면 해당 소스는 예시 데이터로 동작합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# DART 전자공시 OpenAPI — https://opendart.fss.or.kr 에서 발급 (무료 일 20,000건)
DART_API_KEY=

# KOSIS 국가통계포털 공유서비스 — https://kosis.kr/openapi 에서 발급 (무료, 자동승인)
# 위험률 통계 패널(/insurance/stats)에 사용. 없으면 근사치 예시로 동작.
KOSIS_API_KEY=

# DeepL 번역 API — https://www.deepl.com/pro-api 에서 발급 (무료 월 50만 자, 키가 ":fx"로 끝남)
# 일본어·중국어 제목을 한국어로 자동 번역. 없으면 원문 그대로 표시.
DEEPL_API_KEY=
# (선택) 번역 대상 언어. 기본 "ja,zh" — 영어까지 번역하려면 "ja,zh,en"
# TRANSLATE_LANGS=ja,zh

# 열린국회정보 Open API — https://open.assembly.go.kr 에서 발급 (무료)
# 정책·공시 카테고리의 '보험' 키워드 의안 추적에 사용.
ASSEMBLY_API_KEY=

# 한국은행 ECOS 오픈API — https://ecos.bok.or.kr/api 에서 발급 (무료, 자동승인)
# 위험률 통계 패널의 국고채 금리 차트에 사용. 없으면 근사치 예시로 동작.
ECOS_API_KEY=

# KCI(한국학술지인용색인) Open API — https://www.kci.go.kr 에서 발급 (무료)
# 위험률·의료 카테고리의 논문 추적에 사용 (PubMed는 키 불필요).
KCI_API_KEY=
