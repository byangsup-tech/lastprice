# 어린이집정보공개포털(info.childcare.go.kr)에서 발급받은 인증키
# 신청: https://info.childcare.go.kr → 보육정보공개 API → OPEN API 신청
# 키가 없으면 앱은 강남/서초 일대 데모 데이터로 동작합니다.
CHILDCARE_API_KEY=

# (선택) API 엔드포인트 변경 시. 기본값:
# http://api.childcare.go.kr/mediate/rest/cpmsapi021/cpmsapi021/request
# CHILDCARE_API_ENDPOINT=

# ── 보험 상품개발 데스크 (/insurance) ──────────────────────────
# 네이버 API — https://developers.naver.com 앱 등록 후 발급 (무료)
# ※ 앱의 "사용 API"에 [검색]과 [데이터랩(검색어트렌드)]를 둘 다 추가해야
#   같은 키로 뉴스 검색(일 25,000회)과 검색 수요 트렌드(일 1,000회)를 쓸 수 있음.
# 키가 없으면 해당 소스는 예시 데이터로 동작합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (선택) 검색 수요 트렌드 키워드 — 쉼표 구분 최대 5개. 기본값:
# DATALAB_KEYWORDS=펫보험,치아보험,운전자보험,여행자보험,암보험

# DART 전자공시 OpenAPI — https://opendart.fss.or.kr 에서 발급 (무료 일 20,000건)
DART_API_KEY=

# KOSIS 국가통계포털 공유서비스 — https://kosis.kr/openapi 에서 발급 (무료, 자동승인)
# 위험률 통계 패널(/insurance/stats)에 사용. 없으면 근사치 예시로 동작.
KOSIS_API_KEY=

# DeepL 번역 API — https://www.deepl.com/pro-api 에서 발급 (무료 월 50만 자, 키가 ":fx"로 끝남)
# 일본어·중국어 제목을 한국어로 자동 번역. 없으면 원문 그대로 표시.
DEEPL_API_KEY=
# (선택) 번역 대상 언어. 기본 "ja,zh" — 영어까지 번역하려면 "ja,zh,en"
# TRANSLATE_LANGS=ja,zh

# 열린국회정보 Open API — https://open.assembly.go.kr 에서 발급 (무료)
# 정책·공시 카테고리의 '보험' 키워드 의안 추적에 사용.
ASSEMBLY_API_KEY=

# 한국은행 ECOS 오픈API — https://ecos.bok.or.kr/api 에서 발급 (무료, 자동승인)
# 위험률 통계 패널의 국고채 금리 차트에 사용. 없으면 근사치 예시로 동작.
ECOS_API_KEY=

# KCI(한국학술지인용색인) Open API — https://www.kci.go.kr 에서 발급 (무료)
# 위험률·의료 카테고리의 논문 추적에 사용 (PubMed는 키 불필요).
KCI_API_KEY=

# 공공데이터포털 — https://www.data.go.kr 에서 발급 (무료, 활용신청 후 자동승인)
# 통계 패널의 연령별 질환 프로파일(HIRA)·감염병 주간 통계(질병관리청)에 사용.
DATA_GO_KR_API_KEY=

# ── 유튜브 롱폼 스튜디오 (/youtube, npm run yt) ──────────────────
# 모든 키는 선택 사항. 없으면 다음과 같이 폴백합니다:
#   대본: 템플릿 초안 · 음성: Edge TTS(무료) · 시각자료: HTML 카드 · 리서치: 구글 트렌드/뉴스/자동완성/위키(무료)
# Anthropic API — https://console.anthropic.com (대본 생성 · 리서치 후보 재정렬). 없으면 템플릿 모드
ANTHROPIC_API_KEY=
# (선택) YT_LLM_PROVIDER=anthropic|template (기본: 키 있으면 anthropic), YT_LLM_MODEL=claude-opus-5
# YT_LLM_PROVIDER=
# YT_LLM_MODEL=

# TTS — 기본 Edge(무료, 키 불필요). 대안: openai | elevenlabs
# YT_TTS_PROVIDER=edge
# YT_TTS_VOICE=ko-KR-InJoonNeural   (Edge 한국어: ko-KR-InJoonNeural / ko-KR-SunHiNeural / ko-KR-HyunsuMultilingualNeural)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pexels — https://www.pexels.com/api (무료) 장면별 스톡 사진/영상 배경. 없으면 카드만
PEXELS_API_KEY=

# YouTube Data API v3 — 리서치(검색량·경쟁도) 용 API 키. https://console.cloud.google.com
YOUTUBE_API_KEY=
# (선택) 채널 ID — 최근 업로드 제목을 '사용한 주제'로 취급해 중복 제작 방지
YT_CHANNEL_ID=

# YouTube 업로드 — OAuth 클라이언트(데스크톱 앱) + `npm run yt -- auth`로 발급한 리프레시 토큰
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 도구 경로 (자동 탐색 실패 시)
# FFMPEG_PATH=/usr/bin/ffmpeg
# CHROMIUM_PATH=/usr/bin/chromium
# YT_FONT_DIR=/usr/share/fonts/opentype/noto   (apt-get install fonts-noto-cjk)
# 배경음악 mp3 (저작권 확인 — YouTube 오디오 라이브러리 권장). 없으면 BGM 없음
# YT_BGM_PATH=./assets/bgm.mp3
# 대시보드에서 파이프라인 실행(자식 프로세스): 개발 서버는 기본 허용(0이면 금지), 프로덕션(next start)은 1을 명시해야 허용
# YT_ALLOW_LOCAL_RUN=1
# 대시보드를 외부에 노출한다면 쓰기·실행 API 보호용 공유 토큰 (상태 스트립 🔑에서 같은 값 입력)
# YT_DASHBOARD_TOKEN=
