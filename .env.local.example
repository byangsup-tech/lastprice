# 어린이집정보공개포털(info.childcare.go.kr)에서 발급받은 인증키
# 신청: https://info.childcare.go.kr → 보육정보공개 API → OPEN API 신청
# 키가 없으면 앱은 강남/서초 일대 데모 데이터로 동작합니다.
CHILDCARE_API_KEY=

# (선택) API 엔드포인트 변경 시. 기본값:
# http://api.childcare.go.kr/mediate/rest/cpmsapi021/cpmsapi021/request
# CHILDCARE_API_ENDPOINT=

# ── /quantum 대시보드 ────────────────────────────────────────────
# 순수 양자 상장사 시세를 가져오는 금융 API 베이스 URL.
# 기본값은 Yahoo Finance 공개 엔드포인트(키 불필요)이며, 네트워크가
# 차단되면 자동으로 큐레이션 스냅샷으로 폴백합니다.
# STOCK_API_BASE=https://query1.finance.yahoo.com
